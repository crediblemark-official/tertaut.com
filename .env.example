# ==============================================================================
# Tertaut v2 - Environment Template (.env.example)
# Salin berkas ini ke `.env` dan lengkapi nilai variabel sesuai lingkungan Anda.
# ==============================================================================

# 1. Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tertautv2
# DATABASE_SSL=true  # set true untuk database cloud (Supabase, Neon, AWS RDS dsb)

# 2. Server Port & Public URLs
PORT=8081
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_STORE_URL=http://localhost:5173
DEFAULT_PRICE=0

# 3. Security & Session Secrets
# Generate secret acak: openssl rand -base64 32
JWT_SECRET=tertaut_super_secret_jwt_key_at_least_32_characters_long
# BEST PRACTICE: Tetapkan secret acak terpisah per domain (jangan biarkan mewarisi JWT_SECRET):
#   openssl rand -base64 48
BETTER_AUTH_SECRET=
VAULT_ENCRYPTION_KEY=
HWID_SALT=
# true => startup GAGAL di production bila secret terpisah di atas belum disetel
STRICT_SECRETS=false

# 4. Reverse Proxy & Cookies
# true (default): header x-forwarded-for dipercaya untuk rate limiting saat di belakang Traefik/Dokploy/Cloudflare.
TRUST_PROXY=true
# Cookie sesi Secure: otomatis true di production (set true jika staging menggunakan HTTPS).
# USE_SECURE_COOKIES=false

# 5. Super Admin Credentials (Satu-satunya akun platform owner)
ADMIN_EMAIL=platformtertaut@gmail.com
# Password awal akun Super Admin saat pertama kali inisialisasi / seed (opsional, jika kosong digenerate acak):
ADMIN_PASSWORD=

# 6. Ed25519 Universal License Token Key
# Production Dokploy / Docker (Single-line base64):
LICENSE_SIGNING_PRIVATE_KEY_BASE64=
# Atau Local Dev (Berkas fisik di folder ./keys):
# LICENSE_SIGNING_PRIVATE_KEY=keys/license_signing_private.pem

# 7. Email Delivery (Resend)
# PENTING: email HANYA dikirim di production (NODE_ENV=production).
# Dev/test/sandbox melewati pengiriman otomatis agar kuota free tier Resend hemat.
RESEND_API_KEY=
MAIL_FROM="Tertaut <no-reply@mail.tertaut.com>"
EMAIL_REPLY_TO=platformtertaut@gmail.com
# Wajib verifikasi email saat registrasi? Otomatis aktif bila RESEND_API_KEY terisi.
# REQUIRE_EMAIL_VERIFICATION=false

# 8. Payment Gateway Global Selection
# Mode gerbang pembayaran: "dana" atau "xendit" (dapat juga diatur via Panel Admin /panel).
# CATATAN: kode membaca ACTIVE_PAYMENT_GATEWAY (env) atau key DB "active_payment_gateway".
# PAYMENT_GATEWAY diterima sebagai alias agar kompatibel dengan dokumen kompose/CI lama.
ACTIVE_PAYMENT_GATEWAY=dana
PAYMENT_GATEWAY=dana
# Lingkungan DANA: "sandbox" atau "production"
DANA_ENV=sandbox

# 9. DANA Sandbox Credentials (Pengujian & Staging - dashboard.dana.id/sandbox)
# Catatan: Kredensial ini bersifat statis & permanen. Waktu 30 menit di dashboard DANA
# adalah waktu propagasi awal aktivasi saat kredensial baru dibuat.
DANA_SANDBOX_CLIENT_ID=
DANA_SANDBOX_CLIENT_SECRET=
DANA_SANDBOX_MERCHANT_ID=
DANA_SANDBOX_BASE_URL=https://api.sandbox.dana.id
# DANA Sandbox Keys:
# Cara 1 (BEST PRACTICE Dokploy/Docker):
DANA_SANDBOX_PUBLIC_KEY_BASE64=
DANA_SANDBOX_PRIVATE_KEY_BASE64=
# Cara 2 (Local Dev berkas fisik):
# DANA_SANDBOX_PUBLIC_KEY=keys/dana_sandbox_public.pem
# DANA_SANDBOX_PRIVATE_KEY=keys/dana_sandbox_private.pem

# 10. DANA Production Credentials (dashboard.dana.id)
DANA_CLIENT_ID=
DANA_CLIENT_SECRET=
DANA_MERCHANT_ID=
DANA_BASE_URL=https://api.saas.dana.id
# Akun deposit DANA merchant (format 628xxx) untuk transferToBank / disbursement.
# WAJIB di production: tanpa nilai ini pencairan dana ditolak (fail-closed).
DANA_CUSTOMER_NUMBER=
# DANA Production Keys:
# Cara 1 (BEST PRACTICE Dokploy/Docker):
DANA_PUBLIC_KEY_BASE64=
DANA_PRIVATE_KEY_BASE64=
# Cara 2 (Local Dev berkas fisik):
# DANA_PUBLIC_KEY=keys/dana_production_public.pem
# DANA_PRIVATE_KEY=keys/dana_production_private.pem

# DANA Origin URL (opsional, jika redirect DANA memakai domain spesifik):
# DANA_ORIGIN=http://localhost:5173

# 11. Xendit Credentials (Opsional - dashboard.xendit.co)
# Dapatkan dari dashboard.xendit.co (Settings -> API Keys & Webhooks)
# Atau dapat diatur langsung secara dinamis melalui Super Admin Panel (/panel -> Tab Payment Gateway)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_VERIFICATION_TOKEN=
# XENDIT_WEBHOOK_TOKEN=  # alias untuk XENDIT_WEBHOOK_VERIFICATION_TOKEN

# 12. Ops Alerts & Notification (Telegram / Generic Webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_ALERT_WEBHOOK_URL=
