# ==============================================================================
# Tertaut v2 - Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tertautv2

# Security & Session Secrets
JWT_SECRET=tertaut_super_secret_jwt_key_at_least_32_characters_long
# BEST PRACTICE: tetapkan secret acak terpisah per domain (jangan biarkan mewarisi JWT_SECRET):
#   openssl rand -base64 48
# VAULT_ENCRYPTION_KEY=
# BETTER_AUTH_SECRET=
# HWID_SALT=
# STRICT_SECRETS=false  # true => startup GAGAL di production bila secret terpisah di atas kosong

# Reverse proxy (Dokploy/Traefik/nginx/Cloudflare) di depan aplikasi?
# true (default): header x-forwarded-for/x-real-ip dipercaya untuk rate limiting (entry paling kanan).
# false: header IP klien diabaikan total (pakai jika aplikasi terekspos langsung ke internet).
TRUST_PROXY=true

# Cookie sesi memakai atribut Secure. Default: otomatis true di production.
# Set USE_SECURE_COOKIES=true untuk staging yang disajikan via HTTPS.
# USE_SECURE_COOKIES=

# Wajib verifikasi email saat registrasi (email dikirim via Resend).
# Otomatis aktif bila RESEND_API_KEY terisi & NODE_ENV != test. Matikan eksplisit dengan:
# REQUIRE_EMAIL_VERIFICATION=false

# Ed25519 License Token Private Key
# Production Dokploy (Best practice single-line base64):
LICENSE_SIGNING_PRIVATE_KEY_BASE64=
# Atau Local Dev:
# LICENSE_SIGNING_PRIVATE_KEY=keys/license_signing_private.pem

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM="Tertaut <no-reply@mail.tertaut.com>"
EMAIL_REPLY_TO=

# Payment Gateway (DANA SNAP BI)
# Mode: "sandbox" atau "production"
PAYMENT_GATEWAY=dana
DANA_ENV=sandbox

# DANA Production Credentials
DANA_CLIENT_ID=
DANA_CLIENT_SECRET=
DANA_MERCHANT_ID=
DANA_BASE_URL=https://api.saas.dana.id

# DANA Production Keys (PILIH SALAH SATU):
# Cara 1 (BEST PRACTICE untuk Dokploy / Docker / Cloud):
# Jalankan `bun run keys:encode` di lokal, lalu tempel hasilnya ke variabel _BASE64 di bawah:
DANA_PUBLIC_KEY_BASE64=
DANA_PRIVATE_KEY_BASE64=
# Cara 2 (Local Dev saja dengan berkas fisik di folder ./keys):
# DANA_PUBLIC_KEY=keys/dana_production_public.pem
# DANA_PRIVATE_KEY=keys/dana_production_private.pem

# DANA Sandbox Credentials (untuk pengujian & staging)
DANA_SANDBOX_CLIENT_ID=
DANA_SANDBOX_CLIENT_SECRET=
DANA_SANDBOX_MERCHANT_ID=
DANA_SANDBOX_BASE_URL=https://api.sandbox.dana.id

# DANA Sandbox Keys (PILIH SALAH SATU):
# Cara 1 (BEST PRACTICE untuk Dokploy / Docker / Cloud):
DANA_SANDBOX_PUBLIC_KEY_BASE64=
DANA_SANDBOX_PRIVATE_KEY_BASE64=
# Cara 2 (Local Dev saja):
# DANA_SANDBOX_PUBLIC_KEY=keys/dana_sandbox_public.pem
# DANA_SANDBOX_PRIVATE_KEY=keys/dana_sandbox_private.pem
