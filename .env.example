# Server Environment
PORT=3000
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_STORE_URL=https://situsbisnis.com
# Harga default (IDR) untuk produk tanpa target_price; 0 = nonaktif
DEFAULT_PRICE=0

# PostgreSQL Database — aplikasi cukup satu connection string.
# Dev host: localhost. Docker: compose menyusun URL internal dari DB_USER/DB_PASSWORD/DB_NAME,
# sehingga ketiganya WAJIB di-set di environment saat `docker compose up` (tanpa default).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tertautv2

# Security & Encryption
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_tertaut_dev
BETTER_AUTH_SECRET=super_secret_better_auth_key_at_least_32_chars
# 32-byte hexadecimal string for AES-256-GCM Vault
VAULT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Salt tambahan untuk HMAC HWID (opsional; fallback ke JWT_SECRET)
HWID_SALT=
# Ed25519 private key (base64/PEM atau path ke file keys/license_signing_private.pem)
LICENSE_SIGNING_PRIVATE_KEY=

# Email Transaksional (Resend) — tanpa API key, email dilewati
RESEND_API_KEY=
MAIL_FROM="tertaut.com <noreply@tertaut.com>"
EMAIL_REPLY_TO=

# Payment Gateway Selection ('xendit' | 'dana')
PAYMENT_GATEWAY=xendit

# Xendit Payment Gateway (Development/Sandbox)
XENDIT_SECRET_KEY=xnd_development_sample_key_tertaut
XENDIT_PUBLIC_KEY=xnd_public_development_sample_key_tertaut
XENDIT_WEBHOOK_VERIFICATION_TOKEN=tertaut_webhook_verification_token_dev

# DANA Enterprise Payment Gateway (Sandbox / Production)
# Kunci dapat berupa base64 string, PEM string, atau otomatis dibaca dari folder keys/
DANA_CLIENT_ID=
DANA_CLIENT_SECRET=
DANA_MERCHANT_ID=
DANA_BASE_URL=https://api-sandbox.dana.id
DANA_PUBLIC_KEY=
DANA_PRIVATE_KEY=

