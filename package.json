{
  "name": "tertaut",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Headless Developer Infrastructure Engine (Monetization, Universal Licensing, Validation & Launch Kit)",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT,DOCS\" -c \"cyan,yellow,green\" \"bun run dev:server\" \"bun run dev:client\" \"bun run dev:docs\"",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite --config src/client/vite.config.ts src/client",
    "dev:docs": "vitepress dev docs --host localhost --port 5174",
    "docs:preview": "vitepress preview docs --host localhost --port 5174",
    "build": "bun run build:client && bun run build:docs && bun run build:server",
    "build:client": "vue-tsc -p src/client/tsconfig.json && vite build --config src/client/vite.config.ts src/client",
    "build:docs": "vitepress build docs && rm -rf dist/docs && mkdir -p dist/docs && cp -r docs/.vitepress/dist/. dist/docs/",
    "build:server": "tsc --noEmit",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/server/db/migrate.ts",
    "db:rollback": "bun src/server/db/rollback.ts",
    "db:seed": "bun src/server/db/seed.ts",
    "db:reset": "bun src/server/db/reset.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:clean-test": "DATABASE_URL=\"postgresql://tertautuser:doaayyjfjvbd1ml1@localhost:5432/tertautname_test\" bun src/server/db/seed.ts",
    "test": "NODE_ENV=test bun test --parallel=1",
    "test:isolated": "bash scripts/test-isolated.sh",
    "test:gateways": "bash scripts/test-gateways.sh",
    "smoke:gateway": "bun scripts/smoke-gateway.ts",
    "test:coverage": "NODE_ENV=test bun test --coverage --parallel=1",
    "typecheck": "tsc --noEmit && vue-tsc -p src/client/tsconfig.json --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "keys:encode": "bun scripts/encode-keys.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "lucide-vue-next": "^1.0.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "xendit-node": "^7.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vue-tsc": "^2.2.12"
  },
  "lint-staged": {
    "*.{ts,js,vue,json,md}": [
      "prettier --write"
    ]
  }
}
