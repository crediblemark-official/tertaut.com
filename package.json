{
  "name": "tertaut",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Headless Developer Infrastructure Engine (Monetization, Licensing, AI Protection, Validation & Launch Kit)",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT,DOCS\" -c \"cyan,yellow,green\" \"bun run dev:server\" \"bun run dev:client\" \"bun run dev:docs\"",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite --config src/client/vite.config.ts src/client",
    "dev:docs": "vitepress dev docs --host localhost --port 5174",
    "docs:preview": "vitepress preview docs --host localhost --port 5174",
    "build": "bun run build:client && bun run build:docs && bun run build:server",
    "build:client": "vue-tsc -p src/client/tsconfig.json && vite build --config src/client/vite.config.ts src/client",
    "build:docs": "vitepress build docs && rm -rf dist/docs && mkdir -p dist/docs && cp -r docs/.vitepress/dist/. dist/docs/",
    "build:server": "tsc --noEmit",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/server/db/migrate.ts",
    "db:seed": "bun src/server/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "bun test --parallel=1",
    "test:coverage": "bun test --coverage --parallel=1",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "dana-node": "^2.2.2",
    "drizzle-orm": "^0.38.4",
    "elysia": "^1.4.30",
    "lucide-vue-next": "^0.475.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.5.6",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.30.6",
    "husky": "^9.1.7",
    "postcss": "^8.5.28",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitepress": "^1.6.4",
    "vue-tsc": "^2.2.12"
  }
}
