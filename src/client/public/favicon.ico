<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" fill="none">
  <defs>
    <linearGradient id="bgB" x1="0" y1="0" x2="128" y2="128" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#1A1A1A"/>
      <stop offset="100%" stop-color="#0A0A0A"/>
    </linearGradient>
    <linearGradient id="goldB" x1="20" y1="40" x2="108" y2="90" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FFF0A4"/>
      <stop offset="30%" stop-color="#E5C158"/>
      <stop offset="70%" stop-color="#D4AF37"/>
      <stop offset="100%" stop-color="#9E7D1E"/>
    </linearGradient>
    <filter id="shadowB" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#000000" flood-opacity="0.6"/>
    </filter>
  </defs>

  <rect width="128" height="128" rx="28" fill="url(#bgB)"/>
  <rect x="1" y="1" width="126" height="126" rx="27" stroke="url(#goldB)" stroke-opacity="0.3" stroke-width="1.5"/>

  <!-- T Top Crossbar (Solid, bold, unmistakable) -->
  <rect x="22" y="24" width="84" height="14" rx="7" fill="#FFFFFF" filter="url(#shadowB)"/>

  <!-- Lower Chain Link in Gold -->
  <rect x="51" y="56" width="26" height="46" rx="13" stroke="url(#goldB)" stroke-width="9" filter="url(#shadowB)"/>

  <!-- Upper Chain Link extending down from T Crossbar in White -->
  <rect x="51" y="34" width="26" height="42" rx="13" stroke="#FFFFFF" stroke-width="9" filter="url(#shadowB)"/>

  <!-- Overlap weave: Front of upper link goes in front of lower link -->
  <path d="M 51 60 V 63 C 51 70.2 56.8 76 64 76 C 71.2 76 77 70.2 77 63 V 60" 
        stroke="#FFFFFF" stroke-width="9" stroke-linecap="round"/>

  <!-- Connection junction between T bar and upper link -->
  <rect x="57" y="28" width="14" height="10" fill="#FFFFFF"/>
</svg>